# Superseded and bulky material, kept on disk but off the published repo.
# _archive/README.md says what is in there and why each item left.
_archive/

# Large data (regeneratable)
data/activations*/
data/gsm8k/
data/gsm8k_sft/

# Model checkpoints (large binaries)
checkpoints/

# Safety net: never commit stray tensor/model binaries
*.pt
*.safetensors

# Regenerated analysis outputs. The scripts recreate both directories on demand
# (every writer calls mkdir(parents=True, exist_ok=True)); they are outputs, not
# sources, and the published figure set now lives in the paper instead.
figures/
results/cache/

# Python
__pycache__/
*.pyc
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Environment
.env
.venv/
venv/

# IDE / Claude Code
.vscode/
.idea/
.claude/

# Weights & Biases
wandb/

# Run logs / terminal captures
logs/
outputs/
output.txt
*.log

# macOS / editor cruft
.DS_Store
*.swp
*.swo
*~
